<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_album_cover"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_msr_cover_placeholder" />

    <ImageView
        android:id="@+id/widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_scrim"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/jetbrains_mono"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="@string/widget_status_idle"
            android:textColor="#D0D0D0"
            android:textSize="7sp" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat"
            android:letterSpacing="0.02"
            android:maxLines="2"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/jetbrains_mono"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="@string/widget_default_artist"
            android:textAllCaps="true"
            android:textColor="#B5B5B5"
            android:textSize="8sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_previous"
                android:padding="4dp"
                android:src="@drawable/ic_widget_previous" />

            <ImageButton
                android:id="@+id/widget_toggle"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_play_circle"
                android:contentDescription="@string/widget_play"
                android:padding="7dp"
                android:src="@drawable/ic_widget_play_dark" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_next"
                android:padding="4dp"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
