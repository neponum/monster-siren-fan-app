<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical">

    <!-- Editorial top strip: mono brand label + right hatch marks -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/jetbrains_mono"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:text="@string/widget_brand"
            android:textColor="#848484"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/widget_hatches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:letterSpacing="0.08"
            android:text="\\\\"
            android:textColor="#555555"
            android:textSize="9sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/widget_hairline"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="9dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_cover_frame"
            android:contentDescription="@string/cd_album_cover"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_msr_cover_placeholder" />

        <ImageView
            android:id="@+id/widget_accent"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="#4A4A4A"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textAllCaps="true"
                android:textColor="#F0F0F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/jetbrains_mono"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="@string/widget_default_artist"
                android:textAllCaps="true"
                android:textColor="#848484"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/jetbrains_mono"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="@string/widget_status_idle"
                android:textColor="#B5B5B5"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="1dp"
        android:paddingBottom="9dp">

        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="46dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_control_button"
            android:contentDescription="@string/widget_previous"
            android:padding="8dp"
            android:src="@drawable/ic_widget_previous" />

        <ImageButton
            android:id="@+id/widget_toggle"
            android:layout_width="58dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_control_button"
            android:contentDescription="@string/widget_play"
            android:padding="8dp"
            android:src="@drawable/ic_widget_play" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="46dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_control_button"
            android:contentDescription="@string/widget_next"
            android:padding="8dp"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>
</LinearLayout>
